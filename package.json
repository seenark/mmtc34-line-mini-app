{
  "name": "mmtc34-line-mini-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/web",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@mmtc34/config": "workspace:*",
    "@types/node": "^26.4.1",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
